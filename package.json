{
  "name": "jpword-remix",
  "description": "Local JP-Word remix focused on selectable voice-group playback, per-voice volume control, and export from .jpwabc scores.",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.jpword.remix",
    "productName": "JP-Word简谱",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    }
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "lamejs": "^1.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
